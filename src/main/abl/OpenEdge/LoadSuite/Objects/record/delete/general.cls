     * @throws Progress.Lang.Error If validation fails or deletion errors occur.
     */
    method public JsonObject deleteSystemFile (input inSystemID as character ):
        Assert:NotNullOrEmpty(inSystemID).

        do transaction:
            find first SystemFile exclusive-lock
                 where SystemFile.SystemID eq inSystemID no-wait no-error.
            if locked(SystemFile) then return logRecordLock("SystemFile", substitute("&1", inSystemID)).
            if not available(SystemFile) then return oNoRecord.

            delete SystemFile.
        end.

        return oDeletedRecord.
    end method. //SystemFile

end class.
