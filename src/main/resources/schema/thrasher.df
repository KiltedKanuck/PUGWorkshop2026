  VALMSG "Employee must exist."
  HELP "Please enter the emp number"
  ORDER 10

ADD FIELD "DayRecorded" OF "TimeSheet" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Day Recorded"
  MAX-WIDTH 4
  HELP "Please enter the day recorded"
  ORDER 20

ADD FIELD "TypeRecorded" OF "TimeSheet" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Type Recorded"
  MAX-WIDTH 16
  HELP "Please enter Worked, Vacation, Sick, or  Holiday."
  LENGTH 0
  ORDER 30

ADD FIELD "AMTimeIn" OF "TimeSheet" AS character 
  FORMAT "xx:xx"
  INITIAL ""
  LABEL "AM Time In"
  MAX-WIDTH 10
  HELP "Please enter AM Time in"
  LENGTH 0
  ORDER 40

ADD FIELD "AMTimeOut" OF "TimeSheet" AS character 
  FORMAT "xx:xx"
  INITIAL ""
  LABEL "AM Time Out"
  MAX-WIDTH 10
  HELP "Please enter AM Time Out"
  LENGTH 0
  ORDER 50

ADD FIELD "PMTimeIn" OF "TimeSheet" AS character 
  FORMAT "xx:xx"
  INITIAL ""
  LABEL "PM Time In"
  MAX-WIDTH 10
  HELP "Please enter PM Time In"
  LENGTH 0
  ORDER 60

ADD FIELD "PMTimeOut" OF "TimeSheet" AS character 
  FORMAT "xx:xx"
  INITIAL ""
  LABEL "PM Time Out"
  MAX-WIDTH 10
  HELP "Please enter PM Time Out"
  LENGTH 0
  ORDER 70

ADD FIELD "RegularHours" OF "TimeSheet" AS decimal 
  FORMAT ">>9.<<"
  INITIAL "0"
  LABEL "Regular Hours"
  MAX-WIDTH 17
  HELP "Please enter Regular Hours"
  DECIMALS 2
  ORDER 80

ADD FIELD "OvertimeHours" OF "TimeSheet" AS decimal 
  FORMAT ">>9.<<"
  INITIAL "0"
  LABEL "Overtime Hours"
  MAX-WIDTH 17
  HELP "Please enter Overtime Hours"
  DECIMALS 2
  ORDER 90

ADD INDEX "EmpNoDayRecorded" ON "TimeSheet" 
  AREA "Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "EmpNum" ASCENDING 
  INDEX-FIELD "DayRecorded" ASCENDING 

ADD TABLE "Vacation"
  AREA "Data Area"
  DESCRIPTION "The vacation table keeps track of employee vacation time."
  DUMP-NAME "vacation"

ADD FIELD "EmpNum" OF "Vacation" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Emp No"
