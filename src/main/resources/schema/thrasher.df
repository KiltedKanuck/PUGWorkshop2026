  DUMP-NAME "inventor"
  TABLE-TRIGGER "CREATE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/crinvtx.p" CRC "?" 

ADD FIELD "InvTransNum" OF "InventoryTrans" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Inventory Trans Num"
  MAX-WIDTH 4
  HELP "Please enter an inventory trans number"
  ORDER 10

ADD FIELD "WarehouseNum" OF "InventoryTrans" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Warehouse Num"
  MAX-WIDTH 4
  HELP "Please enter the Warehouse Number."
  ORDER 20

ADD FIELD "BinNum" OF "InventoryTrans" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Bin Num"
  MAX-WIDTH 4
  HELP "Please enter a bin number."
  ORDER 30

ADD FIELD "Qty" OF "InventoryTrans" AS int64 
  FORMAT "->>>>9"
  INITIAL "0"
  LABEL "Qty"
  MAX-WIDTH 4
  HELP "Please enter the quantity."
  ORDER 40

ADD FIELD "ItemNum" OF "InventoryTrans" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Item Num"
  MAX-WIDTH 4
  VALEXP "CAN-FIND(item OF inventorytrans)"
  VALMSG "Item must be on file."
  HELP "Please enter an item number"
  ORDER 50

