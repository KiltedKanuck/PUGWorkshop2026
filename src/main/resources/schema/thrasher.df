ADD TABLE "State"
  AREA "Data Area"
  DESCRIPTION "The state table contans state abbreviations and corresponding sales regions"
  VALEXP "NOT (CAN-FIND(FIRST customer OF state))"
  VALMSG "This state record is used by at least one Customer record."
  DUMP-NAME "state"

ADD FIELD "State" OF "State" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "State"
  MAX-WIDTH 40
  HELP "Please enter the state abbreviation."
  ORDER 10

ADD FIELD "StateName" OF "State" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "State Name"
  MAX-WIDTH 40
  HELP "Please enter the full state name."
  ORDER 20

ADD FIELD "Region" OF "State" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Region"
  MAX-WIDTH 16
  HELP "Please enter the sales region for state."
  ORDER 30

ADD INDEX "State" ON "State" 
  AREA "Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "State" ASCENDING 

ADD TABLE "Supplier"
  AREA "Data Area"
  DESCRIPTION "The supplier table contains a supplier's name, address and additional information pertaining to the supplier."
  DUMP-NAME "supplier"
  TABLE-TRIGGER "CREATE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/crsuppl.p" CRC "?" 
  TABLE-TRIGGER "DELETE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/delsuppl.p" CRC "?" 

ADD FIELD "SupplierIDNum" OF "Supplier" AS int64 
  DESCRIPTION "Supplier ID number"
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Supplier ID"
  MAX-WIDTH 4
  COLUMN-LABEL "Supplier ID"
  VALEXP "supplier.SupplierIDnum > 0"
  VALMSG "Supplier number must be greater than zero"
  HELP "Please enter a Supplier ID Number."
  ORDER 10

ADD FIELD "Name" OF "Supplier" AS character 
  DESCRIPTION "Enter Supplier Name"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Name"
  MAX-WIDTH 60
  COLUMN-LABEL "Name"
  HELP "Please enter the Supplier's Name."
  LENGTH 0
  ORDER 11

ADD FIELD "Address" OF "Supplier" AS character 
  FORMAT "x(35)"
  INITIAL ""
  LABEL "Address"
  MAX-WIDTH 70
  COLUMN-LABEL "Address"
  HELP "Please enter the Supplier Address."
  LENGTH 0
  ORDER 12

ADD FIELD "Address2" OF "Supplier" AS character 
  FORMAT "x(35)"
  INITIAL ""
  LABEL "Address2"
  MAX-WIDTH 70
  COLUMN-LABEL "Address2"
  HELP "Please enter the Supplier Address 2."
  LENGTH 0
  ORDER 13

ADD FIELD "City" OF "Supplier" AS character 
  FORMAT "x(25)"
  INITIAL ""
  LABEL "City"
  MAX-WIDTH 50
  COLUMN-LABEL "City"
  HELP "Please enter the Supplier City."
  LENGTH 0
  ORDER 14

ADD FIELD "State" OF "Supplier" AS character 
  DESCRIPTION "Label/Valexp/Valmsg/Help are set based on value of NON-US field!"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "State"
  MAX-WIDTH 40
  COLUMN-LABEL "State"
  HELP "Please enter standard state abbreviation."
  LENGTH 0
  ORDER 15

ADD FIELD "Country" OF "Supplier" AS character 
  FORMAT "x(20)"
  INITIAL "USA"
  LABEL "Country"
  MAX-WIDTH 40
  COLUMN-LABEL "Country"
  HELP "Please enter a county."
  LENGTH 0
  ORDER 18

ADD FIELD "Phone" OF "Supplier" AS character 
  DESCRIPTION "Format/Label/Help based on status of NON-US field."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Phone"
  MAX-WIDTH 40
  COLUMN-LABEL "Phone"
  HELP "Please enter a phone number"
  LENGTH 0
  ORDER 115

ADD FIELD "Password" OF "Supplier" AS character 
  DESCRIPTION "Password for Supplier"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Password"
  MAX-WIDTH 16
  COLUMN-LABEL "Password"
  HELP "Please enter a Password."
  LENGTH 0
  ORDER 190
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "LoginDate" OF "Supplier" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Login Date"
  MAX-WIDTH 4
  COLUMN-LABEL "Login Date"
  HELP "Please enter the Last Login Date."
  ORDER 200

ADD FIELD "Comments" OF "Supplier" AS character 
  FORMAT "x(80)"
  INITIAL ""
  LABEL "Comments"
  MAX-WIDTH 160
  COLUMN-LABEL "Comments"
  HELP "Please enter comments."
  LENGTH 0
  ORDER 180

ADD FIELD "ShipAmount" OF "Supplier" AS int64 
  FORMAT ">>>>9"
  INITIAL "100"
  LABEL "Ship Amount"
  MAX-WIDTH 4
  COLUMN-LABEL "Ship Amount"
  HELP "Please enter the Amount to Ship."
  ORDER 210

ADD FIELD "PostalCode" OF "Supplier" AS character 
  DESCRIPTION "Format/Label/Help Message based on status of NON-US field."
  FORMAT "x(10)"
  INITIAL ""
  LABEL "ZipCode"
  MAX-WIDTH 20
  COLUMN-LABEL "ZipCode"
  HELP "Please enter the appropriate Postal Code."
  LENGTH 0
  ORDER 17

ADD FIELD "Discount" OF "Supplier" AS int64 
  FORMAT ">>9%"
  INITIAL "0"
  LABEL "Discount"
  MAX-WIDTH 4
  VALEXP "Discount >= 0"
  VALMSG "Discount must be greater or equal to 0"
  HELP "Please enter a percentage from 0 to 100."
  ORDER 230

ADD INDEX "SupplierID" ON "Supplier" 
  AREA "Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "SupplierIDNum" ASCENDING 

ADD TABLE "SupplierItemXref"
  AREA "Data Area"
  DESCRIPTION "The supplieritemxref lists all of the items that are supplied by a particlar supplier."
