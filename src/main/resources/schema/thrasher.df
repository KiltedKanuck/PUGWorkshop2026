ADD TABLE "SystemFile"
  AREA "System Data Area"
  DESCRIPTION "Branch records, default settings for the branches, and the category assignment settings for each branch."
  DUMP-NAME "system-f"

ADD FIELD "SystemID" OF "SystemFile" AS character 
  DESCRIPTION "System ID."
  FORMAT "x(8)"
  INITIAL ""
  POSITION 2
  MAX-WIDTH 16
  LENGTH 0
  ORDER 40

ADD FIELD "CompanyName" OF "SystemFile" AS character 
  DESCRIPTION "Used throughout the system to describe the branch. Most visibly in the branch selection drop down list. This is the standard field that is used to display branch description in Agility."
  FORMAT "x(20)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 40
  LENGTH 0
  ORDER 10

ADD FIELD "DefaultPhoneFormat" OF "SystemFile" AS character 
  DESCRIPTION "Format for 'Phone Format 1'. Only reads on the phone formats of the system id flagged as ""corporate""."
  FORMAT "x(30)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 60
  ORDER 50

ADD FIELD "DefaultCurrency" OF "SystemFile" AS character 
  DESCRIPTION "Default currency to use for this account."
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 80

ADD FIELD "DefaultZipFormat" OF "SystemFile" AS character 
  DESCRIPTION "Default postal code format."
  FORMAT "x(12)"
  INITIAL "XXXXX-XXXX"
  LABEL "Default Zip Format"
  POSITION 9
  MAX-WIDTH 24
  ORDER 60

ADD FIELD "DefaultGLGroups" OF "SystemFile" AS character 
  DESCRIPTION "Default GL groups array."
  FORMAT "x(29)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 600
  EXTENT 10
  ORDER 70

ADD FIELD "LastAcctChangeTime" OF "SystemFile" AS character 
  DESCRIPTION "Time last account changed."
  FORMAT "X(8)"
  INITIAL ""
  POSITION 14
  MAX-WIDTH 16
  ORDER 140

ADD FIELD "LastAcctChangeDate" OF "SystemFile" AS date 
  DESCRIPTION "Date last account changed."
  FORMAT "99/99/9999"
  INITIAL "01/01/1990"
  POSITION 15
  MAX-WIDTH 4
  ORDER 130

ADD FIELD "UpdateBy" OF "SystemFile" AS character 
  DESCRIPTION "ID of the user that updated the record."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "update-by"
  POSITION 16
  MAX-WIDTH 24
  HELP "update-by"
  ORDER 260

ADD FIELD "UpdateDate" OF "SystemFile" AS date 
  DESCRIPTION "Date the record was last updated."
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "update-date"
  POSITION 17
  MAX-WIDTH 4
  HELP "update-date"
  ORDER 270

ADD FIELD "UpdateTime" OF "SystemFile" AS character 
  DESCRIPTION "Time the record was last updated."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "update-time"
  POSITION 18
  MAX-WIDTH 16
  HELP "update-time"
  ORDER 280

ADD FIELD "CreatedBy" OF "SystemFile" AS character 
  DESCRIPTION "User ID that created the record."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "CREATED-BY"
  POSITION 19
  MAX-WIDTH 24
  HELP "CREATED-BY"
  ORDER 290

ADD FIELD "CreatedDate" OF "SystemFile" AS date 
  DESCRIPTION "Date when record was created."
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "CREATED-DATE"
  POSITION 20
  MAX-WIDTH 4
  HELP "CREATED-DATE"
  ORDER 300

