  INDEX-FIELD "ItemNum" ASCENDING 

ADD INDEX "ItemNumSupplierID" ON "SupplierItemXref" 
  AREA "Index Area"
  UNIQUE
  INDEX-FIELD "ItemNum" ASCENDING 
  INDEX-FIELD "SupplierIDNum" ASCENDING 

ADD TABLE "TimeSheet"
