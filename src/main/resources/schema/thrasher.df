ADD FIELD "ItemNum" OF "SupplierItemXref" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Item #"
  MAX-WIDTH 4
  COLUMN-LABEL "Item #"
  VALEXP "CAN-FIND(item OF supplieritemxref)"
  VALMSG "Item must be on file."
