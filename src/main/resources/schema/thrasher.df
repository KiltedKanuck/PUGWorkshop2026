  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "PO Num"
  MAX-WIDTH 4
  HELP "Please enter a PO Number."
  ORDER 80

ADD FIELD "OrderNum" OF "InventoryTrans" AS int64 
