  FORMAT "X(12)"
  INITIAL ""
  LABEL "Non-stock Standard Prefix"
  POSITION 31
  MAX-WIDTH 24
  ORDER 390

ADD FIELD "corporate" OF "SystemFile" AS logical 
  DESCRIPTION "Corporate? [Y,N]"
  FORMAT "Yes/No"
  INITIAL "no"
  POSITION 32
  MAX-WIDTH 1
  ORDER 400

ADD FIELD "rxlaser" OF "SystemFile" AS logical 
  DESCRIPTION "RxLaser? [Y,N]"
  FORMAT "Yes/No"
  INITIAL "no"
  LABEL "rxlaser"
  POSITION 33
  MAX-WIDTH 1
  ORDER 410

ADD FIELD "RemitToCustDivLink" OF "SystemFile" AS character 
  DESCRIPTION "Value of the link-cust-div field in the cust-div record that will be used as the remit-to division for the branch represented by this system-file record."
  FORMAT "x(96)"
  INITIAL ""
  LABEL "Remit-to Division"
  POSITION 35
  MAX-WIDTH 192
  COLUMN-LABEL "Remit-to Division"
  ORDER 430

ADD FIELD "FormsCustDivLink" OF "SystemFile" AS character 
  DESCRIPTION "Value of the link-cust-div field in the cust-div record that will be used as the forms division for the branch represented by this system-file record.
"
  FORMAT "x(96)"
  INITIAL ""
  LABEL "Forms Division"
  POSITION 36
  MAX-WIDTH 192
  COLUMN-LABEL "Forms Division"
  ORDER 440

ADD FIELD "TranPrefix" OF "SystemFile" AS character 
  DESCRIPTION "User defined branch identifier that will print before the tran number on all forms."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Tran Prefix"
  POSITION 38
  MAX-WIDTH 8
  ORDER 460

ADD FIELD "AllowPermanentShipTo" OF "SystemFile" AS logical 
  DESCRIPTION "This field gives the branch the ability to control the creation of permanent ship-to records from order entry/quotes. Yes indicates the branch users are allowed to create permanent ship-to records during order entry from a temporary address change. No indicates the branch users are not allowed to create permanent ship-to records during order entry from a temporary address change.  This will save the address change as a temporary address on this order only without giving them the option of creating a permanent ship-to record.
"
  FORMAT "Yes/No"
  INITIAL "no"
  POSITION 39
  MAX-WIDTH 1
  ORDER 470

ADD FIELD "PayTermsCode" OF "SystemFile" AS character 
  DESCRIPTION "Pay terms code selected for this tran."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Pay Terms Code"
  POSITION 40
  MAX-WIDTH 24
  ORDER 480

ADD FIELD "LIFOUpdMethod" OF "SystemFile" AS character 
  DESCRIPTION "Defines LIFO update method used. ""D"" = Double Extension Method (Base Year is never changed) OR ""L"" = Link Chain Method (Base Year is updated with each update with current year activity)."
  FORMAT "x(1)"
  INITIAL "D"
  LABEL "LIFO Update Method"
  POSITION 42
  MAX-WIDTH 2
  ORDER 500

ADD FIELD "CreatedTime" OF "SystemFile" AS character 
  DESCRIPTION "Time the record was created."
  FORMAT "x(8)"
  INITIAL ?
  LABEL "Created Time"
  POSITION 43
  MAX-WIDTH 16
  ORDER 510

ADD FIELD "SeqShared" OF "SystemFile" AS logical 
  DESCRIPTION "Indicates whether this branch gets the sequence number for the transaction id of po_header, so_header, quote_header, or wo_header from a different branch."
  FORMAT "Yes/No"
  INITIAL "no"
  LABEL "Share Tran Seq"
  POSITION 44
  MAX-WIDTH 1
  ORDER 520

ADD FIELD "SeqSystemID" OF "SystemFile" AS character 
  DESCRIPTION "When seq_shared = YES, this field indicates which branch the sequence number for the transaction id of po_header, so_header, quote_header, or wo_header will come from."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Tran Seq Branch"
  POSITION 45
  MAX-WIDTH 16
  ORDER 530

ADD FIELD "DefaultPhoneFormat2" OF "SystemFile" AS character 
  DESCRIPTION "Format for phone format 2. Only reads on the phone formats of the system id flagged as ""corporate""."
