  TABLE-TRIGGER "DELETE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/delinv.p" CRC "?" 

ADD FIELD "InvoiceNum" OF "Invoice" AS int64 
