  AREA "Index Area"
  WORD
  INDEX-FIELD "Contact" ASCENDING 

ADD INDEX "Rating" ON "Feedback" 
  AREA "Index Area"
  INDEX-FIELD "Rating" ASCENDING 

ADD TABLE "InventoryTrans"
  AREA "Data Area"
