  TABLE-TRIGGER "DELETE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/delord.p" CRC "?" 
  TABLE-TRIGGER "WRITE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/wrord.p" CRC "?" 

ADD FIELD "OrderNum" OF "Order" AS int64 
