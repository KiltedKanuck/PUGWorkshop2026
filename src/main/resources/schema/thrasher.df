ADD TABLE "OrderLine"
  AREA "Data Area"
  DESCRIPTION "The orderline table contains order detail information including item number and quantity ordered."
  DUMP-NAME "orderlin"
  TABLE-TRIGGER "CREATE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/crordl.p" CRC "?" 
  TABLE-TRIGGER "DELETE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/delordl.p" CRC "?" 
  TABLE-TRIGGER "WRITE" NO-OVERRIDE PROCEDURE "OpenEdge/LoadSuite/Common/Triggers/wrordl.p" CRC "?" 

ADD FIELD "OrderNum" OF "OrderLine" AS int64 
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Order Num"
  MAX-WIDTH 4
  VALEXP "CAN-FIND(order OF orderline)"
  VALMSG "Order must exist"
  HELP "Please enter and Order Number for this order line."
  ORDER 10

ADD FIELD "LineNum" OF "OrderLine" AS int64 
  DESCRIPTION "To be generated automatically by key value generator!"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Line Num"
  MAX-WIDTH 4
  HELP "Please enter the line number"
  ORDER 20

ADD FIELD "ItemNum" OF "OrderLine" AS int64 
  DESCRIPTION "                                                      Help:Idesc"
  FORMAT "zzzzzzzzz9"
  INITIAL "0"
  LABEL "Item Num"
  MAX-WIDTH 4
  VALEXP "CAN-FIND(item OF orderline)"
  VALMSG "Item must be on file"
  HELP "Please enter an item number."
  ORDER 30

ADD FIELD "Price" OF "OrderLine" AS decimal 
  DESCRIPTION "This field should get its default from the ITEM file's price field."
  FORMAT "->,>>>,>>9.99"
  INITIAL "0"
  LABEL "Price"
  MAX-WIDTH 17
  HELP "Please enter the price"
  DECIMALS 2
  ORDER 40

ADD FIELD "Qty" OF "OrderLine" AS int64 
  FORMAT "->>>>9"
  INITIAL "0"
  LABEL "Qty"
  MAX-WIDTH 4
  HELP "Please enter the quantity."
  ORDER 50

ADD FIELD "Discount" OF "OrderLine" AS int64 
  FORMAT ">>9%"
  INITIAL "0"
  LABEL "Discount"
  MAX-WIDTH 4
  HELP "Please enter a discount."
  ORDER 70

ADD FIELD "ExtendedPrice" OF "OrderLine" AS decimal 
  FORMAT "->>>,>>9.99"
  INITIAL "0"
  LABEL "Extended Price"
  MAX-WIDTH 17
  HELP "Please enter the extended price"
  DECIMALS 2
  ORDER 80

ADD FIELD "OrderLineStatus" OF "OrderLine" AS character 
  FORMAT "x(20)"
  INITIAL "Ordered"
  LABEL "Order Line Status"
  MAX-WIDTH 40
  VIEW-AS "VIEW-AS COMBO-BOX LIST-ITEMS ""Ordered"",""Back Ordered"",""Shipped"""
  HELP "Please enter the order line status."
  ORDER 110

ADD INDEX "OrderLine" ON "OrderLine" 
  AREA "Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "OrderNum" ASCENDING 
  INDEX-FIELD "LineNum" ASCENDING 

ADD INDEX "ItemNum" ON "OrderLine" 
  AREA "Index Area"
  INDEX-FIELD "ItemNum" ASCENDING 

ADD INDEX "OrderLineStatus" ON "OrderLine" 
  AREA "Index Area"
  INDEX-FIELD "OrderLineStatus" ASCENDING 

