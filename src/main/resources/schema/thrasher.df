ADD FIELD "RelativeName" OF "Family" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Relative Name"
  MAX-WIDTH 30
  HELP "Please enter the Relative Name"
  LENGTH 0
  ORDER 10

ADD FIELD "Relation" OF "Family" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Relation"
  MAX-WIDTH 30
  HELP "Please enter Spouse or Child."
  LENGTH 0
  ORDER 20

ADD FIELD "BirthDate" OF "Family" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "BirthDate"
  MAX-WIDTH 4
  HELP "Please enter a BirthDate"
  ORDER 30

