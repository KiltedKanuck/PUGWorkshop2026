  INITIAL "0"
  LABEL "Supplier ID"
  MAX-WIDTH 4
  COLUMN-LABEL "Supplier ID"
  VALEXP "CAN-FIND(supplier OF supplieritemxref)"
  VALMSG "Supplier must exist."
  HELP "Please enter a Supplier ID"
