ADD TABLE "AuditHeader"
  AREA "Audit Header Data Area"
  DESCRIPTION "Header audit records that stores transaction information pertinent to an audit record 

The AuditHeader is used to maintain the relationship between related AuditDetail records, and provides miscellaneous information about where the audit originated."
  DUMP-NAME "aud_head"

ADD FIELD "AuditWord" OF "AuditHeader" AS character 
  DESCRIPTION "Contains specific information about the current Audit Header record."
  FORMAT "x(600)"
  INITIAL ""
  LABEL "Audit Word"
  POSITION 2
  MAX-WIDTH 1200
  ORDER 220

ADD FIELD "ParentAuditKey" OF "AuditHeader" AS int64 
  DESCRIPTION "Stores primary key of related AuditHeader record."
  FORMAT "->,>>>,>>>,>>9"
  INITIAL "0"
  LABEL "Parent Audit Key"
  POSITION 3
  MAX-WIDTH 8
  ORDER 210

ADD FIELD "TranContextTranSysID" OF "AuditHeader" AS character 
  DESCRIPTION "System_id of the transaction id referenced by tran_context_id. This field is populated based on the category assignment of the particular transaction or maintenance record being audited."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Tran System ID"
  POSITION 4
  MAX-WIDTH 16
  ORDER 200

ADD FIELD "RecordKey" OF "AuditHeader" AS character 
  DESCRIPTION "Name value pair list of fields and their values that comprise the primary key of the transaction record associated with this audit."
  FORMAT "x(150)"
  INITIAL ""
  LABEL "Record Key"
  POSITION 5
  MAX-WIDTH 300
  ORDER 190

ADD FIELD "CallStack" OF "AuditHeader" AS character 
  DESCRIPTION "Comma-delimited list of procedures (up to 4 deep) that led up to the audit. Maintenance aid used to trace an audit's origination point. First entry in the list represents module where audit was actually called. Additional entries work backwards from there."
  FORMAT "x(1000)"
  INITIAL ""
  LABEL "Call Stack"
  POSITION 6
  MAX-WIDTH 2000
  ORDER 180

ADD FIELD "AuditType" OF "AuditHeader" AS character 
  DESCRIPTION "Type of audit record, ""Create"", ""Update"" or ""Delete"""
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Audit Type"
  POSITION 7
  MAX-WIDTH 20
  ORDER 170

ADD FIELD "AuditName" OF "AuditHeader" AS character 
  DESCRIPTION "Table or process name of the audit (ie, ""UOM Conversion Error"" or ""so_detail"")."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Audit Name"
  POSITION 8
  MAX-WIDTH 60
  ORDER 160

ADD FIELD "CreatedTime" OF "AuditHeader" AS character 
  DESCRIPTION "Time record was created."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Created Time"
  POSITION 9
  MAX-WIDTH 16
  ORDER 150

ADD FIELD "CreatedDate" OF "AuditHeader" AS date 
  DESCRIPTION "Date record was created."
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Created Date"
  POSITION 10
  MAX-WIDTH 4
  ORDER 140

ADD FIELD "CreatedBy" OF "AuditHeader" AS character 
  DESCRIPTION "UserID of user that created record ('currentUserLogin' property from Session Manager)."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Created By"
  POSITION 11
  MAX-WIDTH 24
  ORDER 130

ADD FIELD "ReviewStatus" OF "AuditHeader" AS character 
  DESCRIPTION "Value indicating review status of the audit. Valid entries: ""Reviewed"" and ""Blank"".   Additional values may be added in the future."
  FORMAT "x(8)"
  INITIAL "Blank"
  LABEL "Review Status"
  POSITION 12
  MAX-WIDTH 16
  ORDER 120

ADD FIELD "WindowTitle" OF "AuditHeader" AS character 
  DESCRIPTION "Title of the active window in Agility for the user's session when audit is performed(ie, ""Sales Order #6700 - [WESTON]"")."
  FORMAT "x(85)"
  INITIAL ""
  LABEL "Window Title"
  POSITION 13
  MAX-WIDTH 170
  ORDER 110

ADD FIELD "ProgramName" OF "AuditHeader" AS character 
  DESCRIPTION "Name of active window in Agility when the audit is being performed (ie, salesord.w, etc)."
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Filename"
  POSITION 14
  MAX-WIDTH 64
  ORDER 100

ADD FIELD "ProfName" OF "AuditHeader" AS character 
  DESCRIPTION "Current branch when audit trigger fired or process audit performed ('currentBranch' property from session manager)."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Prof Name"
  POSITION 15
  MAX-WIDTH 16
  ORDER 90

ADD FIELD "TranContextStatus" OF "AuditHeader" AS character 
  DESCRIPTION "Status of the transaction (if known) when the audit is performed."
  FORMAT "x(25)"
  INITIAL ""
  LABEL "Tran Status"
  POSITION 16
  MAX-WIDTH 50
  ORDER 80

ADD FIELD "TranContextAlt" OF "AuditHeader" AS character 
  DESCRIPTION "Alternate alphanumeric value to further identify the uniqueness of the transaction or maintenance record when other context fields are not sufficient."
  FORMAT "x(800)"
  INITIAL ""
  LABEL "Tran Alt"
  POSITION 17
  MAX-WIDTH 1600
  ORDER 70

ADD FIELD "TranContextSubID" OF "AuditHeader" AS int64 
  DESCRIPTION "Sub-sequence of the transaction record being modified (ie, shipment number, etc)."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Tran SubID"
  POSITION 18
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "TranContextSeq" OF "AuditHeader" AS int64 
  DESCRIPTION "Sequence of the transaction record being modified (ie, so_detail sequence, etc)."
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Tran Seq"
  POSITION 19
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "TranContextSysID" OF "AuditHeader" AS character 
  DESCRIPTION "System_id of the transaction id referenced by tran_context_id. This field is populated based on the category assignment of the particular transaction or maintenance record being audited."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Tran System ID"
  POSITION 20
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "TranContextID" OF "AuditHeader" AS character 
  DESCRIPTION "Alpha-numeric ID field for the transaction or maintenance record being audited.  (i.e., PO ID value of  ""12345"" where the TRAN_CONTEXT_TYPE field value = ""PO"")

"
  FORMAT "x(1000)"
  INITIAL ""
  LABEL "Tran ID"
  POSITION 21
  MAX-WIDTH 2000
  ORDER 30

ADD FIELD "TranContextType" OF "AuditHeader" AS character 
  DESCRIPTION "Identifies the type of audit transaction (ie, PO, SO, WO, Cust, Item, etc)."
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Tran Type"
  POSITION 22
  MAX-WIDTH 64
  ORDER 20

ADD FIELD "AuditKey" OF "AuditHeader" AS int64 
  DESCRIPTION "Primary key for this table. Derived from the database sequence 'audit_key'."
  FORMAT "->,>>>,>>>,>>9"
  INITIAL "0"
  LABEL "Audit Key"
  POSITION 23
  MAX-WIDTH 8
  ORDER 10

ADD FIELD "TranContextCategory" OF "AuditHeader" AS character 
  DESCRIPTION "Category assigned of the audit (table) for the purpose of grouping related table audit records."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Transaction Context Category"
  POSITION 24
  MAX-WIDTH 60
  ORDER 230

ADD FIELD "UpdateBy" OF "AuditHeader" AS character 
  DESCRIPTION "ID of the user that updated the record."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Update By"
  POSITION 25
  MAX-WIDTH 24
  ORDER 240

ADD FIELD "UpdateDate" OF "AuditHeader" AS date 
  DESCRIPTION "Date the record was last updated."
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Update Date"
  POSITION 26
  MAX-WIDTH 4
  ORDER 250

ADD FIELD "UpdateTime" OF "AuditHeader" AS character 
  DESCRIPTION "Time the record was last updated."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Update Time"
  POSITION 27
  MAX-WIDTH 16
  ORDER 260

ADD FIELD "TranContextString" OF "AuditHeader" AS character 
  DESCRIPTION "Miscellaneous string value used to find specific audits faster and to add an additional level of information to audits. The value in this field is stored in the audit_word field making it possible to find these records using an index."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Tran Context String"
  POSITION 28
  MAX-WIDTH 60
  ORDER 270

ADD FIELD "AuthenticatedUser" OF "AuditHeader" AS character 
  DESCRIPTION "This is the authenticated user email address or user name."
  FORMAT "x(254)"
  INITIAL ""
  LABEL "Authenticated User"
  POSITION 29
  MAX-WIDTH 508
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 280

ADD INDEX "PKAuditHeader" ON "AuditHeader" 
  AREA "Audit Header Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "AuditKey" ASCENDING 

ADD INDEX "WAuditWord" ON "AuditHeader" 
  AREA "Audit Header Index Area"
  WORD
  INDEX-FIELD "AuditWord" ASCENDING

ADD TABLE "AuditDetail"
  AREA "Audit Detail Data Area"
  DESCRIPTION "Audit data table that stores the detail information for a specific audit record 

Multiple AuditDetail records may exist for a single AuditHeader record, and may represent multiple process and/or update and delete audits for a given transaction (i.e. transaction identified in AuditHeader may be for a given Sales Order; but AuditDetails related to that record may be for SO_DETAIL, ITEM_RESERVED, and ITEM_BO records)."
  DUMP-NAME "aud_dtl"

ADD FIELD "AuditEntity" OF "AuditDetail" AS character 
  DESCRIPTION "Field or process ""value"" being audited (ie, ""cost"" from so_detail table)."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Audit Entity"
  POSITION 2
  MAX-WIDTH 60
  ORDER 90

ADD FIELD "AfterValue" OF "AuditDetail" AS character 
  DESCRIPTION "Value of the field after the change is made. Does not apply to delete audits."
  FORMAT "x(16000)"
  INITIAL ""
  LABEL "After Value"
  POSITION 3
  MAX-WIDTH 31995
  ORDER 70

ADD FIELD "BeforeValue" OF "AuditDetail" AS character 
  DESCRIPTION "Value of the field before the change is made or the delete performed."
  FORMAT "x(16000)"
  INITIAL ""
  LABEL "Before Value"
  POSITION 4
  MAX-WIDTH 31995
  ORDER 60

ADD FIELD "AuditKey" OF "AuditDetail" AS int64 
  DESCRIPTION "Foreign key to the AuditHeader table. Derived from the database sequence 'audit_key'."
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Audit Key"
  POSITION 5
  MAX-WIDTH 8
  ORDER 10

ADD INDEX "PKAuditDetail" ON "AuditDetail" 
  AREA "Audit Detail Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "AuditKey" ASCENDING 
  INDEX-FIELD "AuditEntity" ASCENDING

ADD TABLE "ContextHeader"
  AREA "Context Data Area"
  DESCRIPTION "Identifier for a specific login of a specific user. If a user is logged in twice, or connected to the Agility AppServer for two different processes, then there will be two ContextHeader records for the user. ContextHeader, along with ContextDetail, is used to store information from or for a particular client-side session on the server, so that it can be used again if that client-side session calls another program on the server."
  DUMP-NAME "ctx_head"

ADD FIELD "ProductCode" OF "ContextHeader" AS character 
  DESCRIPTION "Code for product (Agility, PrtnrView, etc) for which context is being stored."
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Product Code"
  POSITION 2
  MAX-WIDTH 20
  ORDER 50

ADD FIELD "ClientUserID" OF "ContextHeader" AS character 
  DESCRIPTION "User ID of the client process that asked to establish the session context.  Should correspond to a valid user of the DMSI product (Agility, PartnerView, etc) that is providing access to the client process."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "User ID"
  POSITION 3
  MAX-WIDTH 24
  ORDER 40

ADD FIELD "SetUserInfo" OF "ContextHeader" AS character 
  DESCRIPTION "Information derived on the server side at login time that is used in subsequent calls to set the database user ID for database monitoring tools to see. The data in this field is encrypted before it is stored, and is not readable when queried."
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Setuser Info"
  POSITION 4
  MAX-WIDTH 80
  ORDER 30

ADD FIELD "ContextLastAccess" OF "ContextHeader" AS datetime 
  DESCRIPTION "Indicates last time server was accessed by a particular client session."
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Context Last Access"
  POSITION 5
  MAX-WIDTH 80
  ORDER 20

ADD FIELD "ContextID" OF "ContextHeader" AS character 
  DESCRIPTION "Unique value that identifies a particular client process-to-appserver relationship. The value is established by the AppServer when the client process makes it�s first call, and is passed back to the client process.  The client process then passes the context_id on subsequent calls to the AppServer, so the server programs can access any context information that has been stored for that client session in the ContextDetail table."
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Context ID"
  POSITION 6
  MAX-WIDTH 400
  ORDER 10

ADD INDEX "PKContextHeader" ON "ContextHeader" 
  AREA "Context Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ContextID" ASCENDING 

ADD INDEX "XLastAccess" ON "ContextHeader" 
  AREA "Context Index Area"
  INDEX-FIELD "ContextLastAccess" ASCENDING 

ADD INDEX "XProductContext" ON "ContextHeader" 
  AREA "Context Index Area"
  INDEX-FIELD "ProductCode" ASCENDING 
  INDEX-FIELD "ContextID" ASCENDING 

ADD INDEX "XUserID" ON "ContextHeader" 
  AREA "Context Index Area"
  INDEX-FIELD "ClientUserID" ASCENDING 

ADD TABLE "ContextDetail"
  AREA "Context Data Area"
  DESCRIPTION "Property name and value for a specific login of a specific user. Related to ContextHeader by CONTEXT_ID. There can be many ContextDetail records for one ContextHeader."
  DUMP-NAME "ctx_dtl"

ADD FIELD "PropertyValue" OF "ContextDetail" AS character 
  DESCRIPTION "Value of a context property being saved for the client process identified by context_id. "
  FORMAT "x(10000)"
  INITIAL ""
  LABEL "Property Value"
  POSITION 2
  MAX-WIDTH 20000
  ORDER 30

ADD FIELD "PropertyName" OF "ContextDetail" AS character 
  DESCRIPTION "Name of a context property being saved for the client process identified by context_id. "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Property Name"
  POSITION 3
  MAX-WIDTH 80
  ORDER 20

ADD FIELD "ContextID" OF "ContextDetail" AS character 
  DESCRIPTION "Value that identifies a particular client process for which the property in the ContextDetail record was saved. "
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Context ID"
  POSITION 4
  MAX-WIDTH 400
  ORDER 10

ADD INDEX "PKContextDetail" ON "ContextDetail" 
  AREA "Context Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ContextID" ASCENDING 
  INDEX-FIELD "PropertyName" ASCENDING

