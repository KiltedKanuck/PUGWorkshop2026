  ORDER 5

ADD FIELD "StartDate" OF "Vacation" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Start Date"
  MAX-WIDTH 4
  HELP "Please enter the Start Date."
  ORDER 15

ADD FIELD "EndDate" OF "Vacation" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "End Date"
  MAX-WIDTH 4
  HELP "Please enter the End Date."
  ORDER 25

ADD INDEX "EmpNoStartDate" ON "Vacation" 
  AREA "Index Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "EmpNum" ASCENDING 
  INDEX-FIELD "StartDate" ASCENDING 

