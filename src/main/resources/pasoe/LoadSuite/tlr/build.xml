<?xml version="1.0" encoding="UTF-8"?>
<project name="OpenEdge ARchive Tailoring" basedir=".">

    <description>
        Template build file for ABL application deployment tailoring.
        Added to instance ablapps appname tlr directory.
        See: https://docs.progress.com/bundle/pas-for-openedge-management/page/Tailor-an-ABLApp-installation-using-Ant.html
        Order of events for an OEAR import is ablapp_deploy then ablapp_deployed
    </description>

    <!-- Set environment variables required for the ANT script -->
    <property environment="env"/>
    <fail unless="env.DLC" message="Script must be executed within a DLC environment!"/>

    <macrodef name="init_env">
        <attribute name="target"/>
        <sequential>
            <!-- Target entry marker to show exactly when PASOE tailoring invokes each lifecycle hook. -->
            <echo message="Entering Target: @{target}"/>

            <!-- Derive key paths from environment variables; silently skips if not present -->
            <condition property="dlcHome" value="${env.DLC}">
                <isset property="env.DLC"/>
            </condition>
            <condition property="catalina.home" value="${env.CATALINA_HOME}">
                <isset property="env.CATALINA_HOME"/>
            </condition>
            <condition property="catalina.base" value="${env.CATALINA_BASE}">
                <isset property="env.CATALINA_BASE"/>
            </condition>

            <!-- Derive tcman instance properties; silently skips if not present -->
            <condition property="tcman.alias" value="${env.tcman_alias}">
                <isset property="env.tcman_alias"/>
            </condition>
            <condition property="tcman.instance.base" value="${env.tcman_instancebase}">
                <isset property="env.tcman_instancebase"/>
            </condition>
            <condition property="tcman.http.port" value="${env.tcman_cfghttpport}">
                <isset property="env.tcman_cfghttpport"/>
            </condition>
            <condition property="tcman.https.port" value="${env.tcman_cfghttpsport}">
                <isset property="env.tcman_cfghttpsport"/>
            </condition>
            <condition property="tcman.shutdown.port" value="${env.tcman_cfgshutport}">
                <isset property="env.tcman_cfgshutport"/>
            </condition>
            <condition property="tcman.debug" value="${env.tcman_debug}">
                <isset property="env.tcman_debug"/>
            </condition>
            <condition property="tcman.sec.model" value="${env.tcman_secmodel}">
                <isset property="env.tcman_secmodel"/>
            </condition>
            <condition property="tcman.type" value="${env.tcman_type}">
                <isset property="env.tcman_type"/>
            </condition>
            <condition property="tcman.verbose" value="${env.tcman_verbose}">
                <isset property="env.tcman_verbose"/>
            </condition>

            <!-- Set properties based on OS family. -->
            <condition property="isWindows">
                <os family="windows"/>
            </condition>
            <condition property="isUnix">
                <os family="unix"/>
            </condition>

            <!-- Set PASOE utility paths based on operating system. -->
            <property name="dlc.bin" value="${dlcHome}${file.separator}bin"/>
            <condition property="client.exec" value="pro" else="pro.bat">
                <os family="unix"/>
            </condition>
            <condition property="oeprop.name" value="oeprop.sh" else="oeprop.bat">
                <os family="unix"/>
            </condition>
            <condition property="secprop.name" value="secprop.sh" else="secprop.bat">
                <os family="unix"/>
            </condition>
            <property name="secprop.util" value="${catalina.home}${file.separator}bin${file.separator}${secprop.name}"/>
            <condition property="tcman.name" value="tcman.sh" else="tcman.bat">
                <os family="unix"/>
            </condition>

            <!-- Set database utility paths based on operating system. -->
            <condition property="prostrct.exec" value="prostrct" else="prostrct.bat">
                <os family="unix"/>
            </condition>
            <condition property="procopy.exec" value="procopy" else="procopy.bat">
                <os family="unix"/>
            </condition>
            <condition property="proutil.exec" value="proutil" else="proutil.bat">
                <os family="unix"/>
            </condition>

            <!-- Set properties for key locations and files. -->
            <property name="db.path" value="${catalina.base}${file.separator}db"/>
            <property name="pas.bin" value="${catalina.base}${file.separator}bin"/>
            <property name="pas.openedge" value="${catalina.base}${file.separator}openedge"/>
            <property name="oeprop.util" value="${pas.bin}${file.separator}${oeprop.name}"/>
            <property name="tcman.util" value="${pas.bin}${file.separator}${tcman.name}"/>
            <property name="pas.conf.dir" value="${catalina.base}${file.separator}conf"/>
            <property name="ablapp.tlr.dir" value="${basedir}"/>
            <property name="ablapp.dir" value="${ablapp.tlr.dir}${file.separator}.."/>
            <property name="ablapp.tlr.extras.dir" value="${ablapp.dir}${file.separator}tlr${file.separator}extras"/>
            <property name="root.zip.file" value="${ablapp.tlr.extras.dir}${file.separator}ROOT.zip"/>
            <property name="swaggerui.war.file" value="${ablapp.tlr.extras.dir}${file.separator}swaggerui.war"/>
            <property name="schema.dir" value="${ablapp.tlr.dir}${file.separator}schema"/>

            <!-- Add the appropriate ANT-Contrib library to this environment (v1.0b3 in 12.8+). -->
            <loadtask resource="net/sf/antcontrib/antcontrib.properties" classfile="${dlcHome}/ant/lib/ant-contrib-1.0b3.jar"/>

            <!-- ant-contrib does not map 'for' in antcontrib.properties. -->
            <taskdef name="for" classname="net.sf.antcontrib.logic.ForTask" classpath="${dlcHome}/ant/lib/ant-contrib-1.0b3.jar"/>

            <!-- Utilize a local file for properties. Allows this XML to provide defaults only. -->
            <local name="install.properties.file"/>
            <property name="install.properties.file" value="${catalina.base}${file.separator}install.properties"/>
            <local name="install.properties.exists"/>
            <available file="${install.properties.file}" type="file" property="install.properties.exists"/>
            <if>
                <isset property="install.properties.exists"/>
                <then>
                    <property file="${install.properties.file}"/>

                    <!-- Report the system resources, if available. -->
                    <echo message="  System Hostname: ${system.detected.hostname}"/>
                    <echo message=" System CPU Count: ${system.detected.cpus}"/>
                    <echo message="Total Memory (MB): ${system.detected.memory}"/>

                    <!-- Minimum system memory (MB) required before applying resource-intensive tailoring. -->
                    <property name="minTailoringMemory" value="14336"/>

                    <!-- Check if system.detected.memory is a numeric value (not "unknown"). -->
                    <local name="memory.is.numeric"/>
                    <condition property="memory.is.numeric">
                        <matches string="${system.detected.memory}" pattern="^\d+$"/>
                    </condition>

                    <!-- Determine whether the system has sufficient memory for resource-intensive tailoring. -->
                    <if>
                        <isset property="memory.is.numeric"/>
                        <then>
                            <!-- First compare using math: result will be > 0 if system.detected.memory > minTailoringMemory -->
                            <math result="memory.difference" operand1="${system.detected.memory}" operation="-" operand2="${minTailoringMemory}" datatype="int"/>
                            <!-- Next check if the result is positive, indicating enough headroom for tailoring. -->
                            <condition property="has.sufficient.memory">
                                <matches string="${memory.difference}" pattern="^[1-9]\d*$"/>
                            </condition>
                        </then>
                        <else>
                            <echo message="WARNING: system.detected.memory is not numeric ('${system.detected.memory}'). Defaulting to insufficient memory."/>
                        </else>
                    </if>
                </then>
                <else>
                    <echo message="WARNING: install.properties not found at: ${install.properties.file}"/>
                </else>
            </if>
            <property name="has.sufficient.memory" value="false"/>

            <!-- Security domain settings, applies defaults if not configured. -->
            <property name="application.domain.name" value="${pasoe.instance.name}"/>
            <property name="application.domain.code" value="${primary.ablapp.name}"/>
        </sequential>
    </macrodef>

    <macrodef name="loadtask">
        <!-- Usage <loadtask resource="_resource_string_" classfile="_path_to_file_"/> -->
        <attribute name="resource"/>
        <attribute name="classfile"/>

        <sequential>
            <local name="task.file.exists"/>
            <condition property="task.file.exists">
                <available file="@{classfile}" type="file"/>
            </condition>

            <taskdef resource="@{resource}" classpath="@{classfile}"/>
        </sequential>
    </macrodef>

    <macrodef name="require">
        <!-- Usage <require file="_path_to_file_"/> -->
        <attribute name="file"/>
        <attribute name="message" default="File @{file} not set or missing"/>

        <sequential>
            <fail message="@{message}">
                <condition>
                    <not>
                        <available file="@{file}" type="file"/>
                    </not>
                </condition>
            </fail>
        </sequential>
    </macrodef>

    <macrodef name="hasExistingDir">
        <!-- Usage <hasExistingDir folder="_path_to_folder_"/> -->
        <attribute name="folder"/>
        <attribute name="message" default="Directory @{folder} already exists!"/>

        <sequential>
            <fail message="@{message}">
                <condition>
                    <available file="@{folder}" type="dir"/>
                </condition>
            </fail>
        </sequential>
    </macrodef>

    <macrodef name="requireDir">
        <!-- Usage <requireDir folder="_path_to_folder_"/> -->
        <attribute name="folder"/>
        <attribute name="message" default="Directory @{folder} not set or missing"/>

        <sequential>
            <fail message="@{message}">
                <condition>
                    <not>
                        <available file="@{folder}" type="dir"/>
                    </not>
                </condition>
            </fail>
        </sequential>
    </macrodef>

    <macrodef name="replaceROOT">
        <sequential>
            <!-- Remove the default ROOT ABLWebApp and its related default ABL Application. -->
            <echo message="Undeploying the default ROOT ABLWebApp..."/>
            <exec executable="${tcman.util}" failonerror="true">
                <arg line="undeploy ROOT"/>
            </exec>

            <!-- Create a new ROOT for static content as a non-ABL Tomcat webapp. -->
            <local name="root.dir.exists"/>
            <property name="pas.webapps.root.dir" value="${catalina.base}${file.separator}webapps${file.separator}ROOT"/>
            <available file="${pas.webapps.root.dir}" property="root.dir.exists"/>
            <if>
                <isset property="root.dir.exists"/>
                <then>
                    <echo message="The ROOT webapp still exists, skipping extraction."/>
                </then>
                <else>
                    <echo message="Extracting basic webapp files to ROOT..."/>
                    <unzip src="${root.zip.file}" dest="${pas.webapps.root.dir}" overwrite="true"/>
                </else>
            </if>
        </sequential>
    </macrodef>

    <macrodef name="deployWebApp">
        <!-- Usage <deployWebApp archive="_path_to_war_"/> -->
        <attribute name="archive"/>

        <sequential>
            <!-- Deploy the static webapp directly to the PASOE instance. -->
            <echo message="Deploying static WebApp '@{archive}'..."/>
            <exec executable="${tcman.util}" failonerror="true">
                <arg line="deploy -v @{archive}"/>
            </exec>
        </sequential>
    </macrodef>

    <macrodef name="mergeSecurityProperties">
        <attribute name="file"/>
        <attribute name="target"/>
        <sequential>
            <!-- Check if the properties file exists and handle accordingly. -->
            <local name="merge.file.exists"/>
            <available file="@{file}" property="merge.file.exists"/>
            <if>
                <isset property="merge.file.exists"/>
                <then>
                    <echo message="Merging security properties '@{file}' to '@{target}'"/>
                    <exec executable="${secprop.util}" failonerror="true">
                        <arg value="-f"/>
                        <arg value="-w"/>
                        <arg value="@{target}"/>
                        <arg value="@{file}"/>
                    </exec>
                </then>
                <else>
                    <echo message="WARNING: File '@{file}' not found. Skipping security properties merge."/>
                </else>
            </if>
        </sequential>
    </macrodef>

    <macrodef name="build_db">
        <attribute name="dbPath"/>
        <attribute name="dbName"/>
        <sequential>
            <!--
                db.name.present: Treats either empty or "none" as no database configured.
                This prevents accidental DB creation when other app assets (like /db) exist.
            -->
            <local name="db.name.present"/>
            <condition property="db.name.present" value="true" else="false">
                <and>
                    <not>
                        <matches string="@{dbName}" pattern="^\s*$"/>
                    </not>
                    <not>
                        <matches string="@{dbName}" pattern="(?i)^none$"/>
                    </not>
                </and>
            </condition>

            <!--
                DB provisioning requires both the structure file and compiled schema loader.
                If either is missing, skip instead of attempting a partial/failing DB build.
            -->
            <local name="db.schema.ready"/>
            <condition property="db.schema.ready" value="true" else="false">
                <and>
                    <available file="${schema.dir}${file.separator}@{dbName}.df" type="file"/>
                    <available file="${schema.dir}${file.separator}@{dbName}.st" type="file"/>
                    <available file="${schema.dir}${file.separator}createdomain.r" type="file"/>
                    <available file="${schema.dir}${file.separator}loadschema.r" type="file"/>
                </and>
            </condition>

            <!--
                Final DB gate: create only when all prerequisites are true.
                Any false signal means skip DB creation for a safe, no-DB install path.
            -->
            <local name="skip.db.creation"/>
            <condition property="skip.db.creation">
                <or>
                    <equals arg1="${db.name.present}" arg2="false"/>
                    <equals arg1="${db.schema.ready}" arg2="false"/>
                </or>
            </condition>

            <if>
                <isset property="skip.db.creation"/>
                <then>
                    <echo message="WARNING: Skipping database creation due to missing name or files."/>
                </then>
                <else>
                    <!-- Create the PAS database using the values (or defaults) provided. -->
                    <echo message="${line.separator}Creating DB instance at @{dbPath}..."/>

                    <!-- Ensure the DB folder exists under CATALINA_BASE before creation. -->
                    <mkdir dir="@{dbPath}"/>

                    <requireDir folder="@{dbPath}"/>
                    <requireDir folder="${schema.dir}"/>
                    <require file="${dlc.bin}${file.separator}${client.exec}"/>
                    <require file="${dlc.bin}${file.separator}${proutil.exec}"/>
                    <require file="${dlc.bin}${file.separator}${prostrct.exec}"/>
                    <require file="${dlc.bin}${file.separator}${procopy.exec}"/>

                    <!-- Copy all schema assets into the DB working folder for local execution. -->
                    <copy todir="@{dbPath}" overwrite="true">
                        <fileset dir="${schema.dir}">
                            <include name="**/*"/>
                        </fileset>
                    </copy>

                    <local name="cluster.size"/>
                    <property name="cluster.size" value="65536"/>

                    <local name="biblock.size"/>
                    <property name="biblock.size" value="16"/>

                    <local name="bigrow.size"/>
                    <property name="bigrow.size" value="4"/>

                    <local name="db.server.intl"/>
                    <property name="db.server.intl" value="-cpinternal ${application.db.codepage} -cpcoll ${application.db.collation}"/>

                    <!-- Create the database from a structure file with 8K block size. -->
                    <echo message="Creating database from structure file..."/>
                    <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${prostrct.exec}"
                          output="@{dbPath}${file.separator}prostrct_create.log" failonerror="true">
                        <arg value="create"/>
                        <arg value="@{dbName}"/>
                        <arg value="@{dbName}.st"/>
                        <arg line="-blocksize 8192"/>
                    </exec>

                    <!-- Copy an empty 8K database. -->
                    <if>
                        <equals arg1="${application.db.codepage}" arg2="UTF-8"/>
                        <then>
                            <echo message="Copying empty8 UTF database..."/>
                            <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${procopy.exec}"
                                  output="@{dbPath}${file.separator}procopy_empty_utf.log" failonerror="true">
                                <arg value="${dlcHome}${file.separator}prolang${file.separator}utf${file.separator}empty8"/>
                                <arg value="@{dbName}"/>
                            </exec>
                        </then>
                        <else>
                            <echo message="Copying empty8 database..."/>
                            <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${procopy.exec}"
                                  output="@{dbPath}${file.separator}procopy_empty.log" failonerror="true">
                                <arg value="${dlcHome}${file.separator}empty8"/>
                                <arg value="@{dbName}"/>
                            </exec>
                        </else>
                    </if>

                    <!-- Use a procedure (as r-code) to load the schema into the database. -->
                    <echo message="Loading database schema..."/>
                    <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${client.exec}"
                          output="@{dbPath}${file.separator}loadschema.log" failonerror="true">
                        <arg value="-db"/>
                        <arg value="@{dbName}"/>
                        <arg value="-1"/>
                        <arg value="-rx"/>
                        <arg value="-b"/>
                        <arg value="-p"/>
                        <arg value="loadschema.r"/>
                    </exec>

                    <!-- Create or update the DB security domain for SSO token assertion. -->
                    <echo message="Configuring database security domain..."/>
                    <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${client.exec}"
                          output="@{dbPath}${file.separator}createdomain.log" failonerror="true">
                        <arg value="-db"/>
                        <arg value="@{dbName}"/>
                        <arg value="-1"/>
                        <arg value="-rx"/>
                        <arg value="-b"/>
                        <arg value="-param"/>
                        <arg value="domainName=${application.domain.name};accessCode=${application.domain.code}"/>
                        <arg value="-p"/>
                        <arg value="createdomain.r"/>
                    </exec>

                    <!-- Truncates the BI file before proceeding with a BI grow. -->
                    <echo message="Truncating BI: -C truncate bi -G 1 -bi ${cluster.size} -biblocksize ${biblock.size} ${db.server.intl}"/>
                    <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${proutil.exec}"
                          output="@{dbPath}${file.separator}proutil_truncatebi.log" failonerror="true">
                        <arg value="@{dbName}"/>
                        <arg value="-C"/>
                        <arg value="truncate"/>
                        <arg value="bi"/>
                        <arg value="-G"/>
                        <arg value="1"/>
                        <arg value="-bi"/>
                        <arg value="${cluster.size}"/>
                        <arg value="-biblocksize"/>
                        <arg value="${biblock.size}"/>
                        <arg line="${db.server.intl}"/>
                    </exec>

                    <!-- Pre-grow the BI file to avoid dynamic resizing later. -->
                    <echo message="BI Grow: -C bigrow ${bigrow.size} -r ${db.server.intl}"/>
                    <exec dir="@{dbPath}" executable="${dlc.bin}${file.separator}${proutil.exec}"
                          output="@{dbPath}${file.separator}proutil_bigrow.log" failonerror="true">
                        <arg value="@{dbName}"/>
                        <arg value="-C"/>
                        <arg value="bigrow"/>
                        <arg value="${bigrow.size}"/>
                        <arg value="-r"/>
                        <arg line="${db.server.intl}"/>
                    </exec>
                </else>
            </if>
        </sequential>
    </macrodef>

    <target name="ablapp_deploy">
        <!-- Called when an ABLApp is being prepared to be imported. -->
    </target>

    <target name="ablapp_deployed">
        <!-- Called when an ABLApp has finished being imported. -->
        <init_env target="ablapp_deployed"/>

        <!-- Replace the default ROOT with static content. -->
        <local name="root.zip.exists"/>
        <available file="${root.zip.file}" property="root.zip.exists"/>
        <if>
            <isset property="root.zip.exists"/>
            <then>
                <replaceROOT/>
            </then>
            <else>
                <echo message="WARNING: ROOT.zip file not found at '${root.zip.file}'. Skipping ROOT webapp replacement."/>
            </else>
        </if>

        <!-- Deploy the static swaggerui webapp. -->
        <local name="swaggerui.war.exists"/>
        <available file="${swaggerui.war.file}" property="swaggerui.war.exists"/>
        <if>
            <isset property="swaggerui.war.exists"/>
            <then>
                <deployWebApp archive="${swaggerui.war.file}"/>
            </then>
            <else>
                <echo message="NOTE: SwaggerUI.war file not found at '${swaggerui.war.file}'. Skipping SwaggerUI webapp deployment."/>
            </else>
        </if>

        <!-- Replace tokens in lifecycle scripts and supporting properties files. -->
        <echo message="Update tokens for lifecycle scripts and supporting properties..."/>
        <replace dir="${pas.bin}">
            <include name="instance_*.*"/>
            <include name="*_setenv.*"/>
            <include name="*.properties"/>
            <replacefilter token="@DLCHOME@" value="${dlcHome}"/>
            <replacefilter token="@DBPATH@" value="${db.path}"/>
            <replacefilter token="@DBNAME@" value="${application.db.name}"/>
            <replacefilter token="@DBHOST@" value="${application.db.host.name}"/>
            <replacefilter token="@DBPORT@" value="${application.db.port.service}"/>
            <replacefilter token="@MINPORT@" value="${application.db.port.min}"/>
            <replacefilter token="@MAXPORT@" value="${application.db.port.max}"/>
            <replacefilter token="@LOCKWAIT@" value="${application.db.lockwait}"/>
            <replacefilter token="@CODEPAGE@" value="${application.db.codepage}"/>
            <replacefilter token="@COLLATION@" value="${application.db.collation}"/>
            <replacefilter token="@DATEFORMAT@" value="${dateformat}"/>
            <replacefilter token="@NUMSEP@" value="${numsep}"/>
            <replacefilter token="@NUMDEC@" value="${numdec}"/>
            <replacefilter token="@PASPATH@" value="${catalina.base}"/>
            <replacefilter token="@PRIMARY_ABLAPP@" value="${primary.ablapp.name}"/>
        </replace>

        <!-- Replace tokens in the ABL Application's config/parameter file(s). -->
        <echo message="Update tokens for .config and .pf file(s)..."/>
        <replace dir="${ablapp.dir}${file.separator}openedge">
            <include name="*.config"/>
            <include name="*.pf"/>
            <replacefilter token="@DLCHOME@" value="${dlcHome}"/>
            <replacefilter token="@DBPATH@" value="${db.path}"/>
            <replacefilter token="@DBNAME@" value="${application.db.name}"/>
            <replacefilter token="@DBHOST@" value="${application.db.host.name}"/>
            <replacefilter token="@DBPORT@" value="${application.db.port.service}"/>
            <replacefilter token="@MINPORT@" value="${application.db.port.min}"/>
            <replacefilter token="@MAXPORT@" value="${application.db.port.max}"/>
            <replacefilter token="@LOCKWAIT@" value="${application.db.lockwait}"/>
            <replacefilter token="@CODEPAGE@" value="${application.db.codepage}"/>
            <replacefilter token="@COLLATION@" value="${application.db.collation}"/>
            <replacefilter token="@DATEFORMAT@" value="${dateformat}"/>
            <replacefilter token="@NUMSEP@" value="${numsep}"/>
            <replacefilter token="@NUMDEC@" value="${numdec}"/>
            <replacefilter token="@HOSTNAME@" value="${system.detected.hostname}"/>
            <replacefilter token="@PASPATH@" value="${catalina.base}"/>
            <replacefilter token="@PASALIAS@" value="${tcman.alias}"/>
            <replacefilter token="@PASHTTP@" value="${tcman.http.port}"/>
            <replacefilter token="@PASHTTPS@" value="${tcman.https.port}"/>
            <replacefilter token="@PRIMARY_ABLAPP@" value="${primary.ablapp.name}"/>
            <replacefilter token="@PRIMARY_WEBAPP@" value="${primary.webapp.name}"/>
        </replace>

        <!-- Make all BASH shell script executable. -->
        <echo message="Set executable bit for lifecycle shell scripts..."/>
        <chmod perm="755">
            <fileset dir="${pas.bin}">
                <include name="instance_*.sh"/>
                <include name="*_setenv.sh"/>
            </fileset>
        </chmod>

        <!-- Merge the security properties for the webapp of each ABLApp in the PAS instance (by alias). -->
        <local name="tlr.merge.file"/>
        <property name="tlr.merge.file" value="${ablapp.tlr.dir}${file.separator}merge.oeablSecurity.properties"/>
        <local name="tlr.merge.file.exists"/>
        <available file="${tlr.merge.file}" property="tlr.merge.file.exists"/>
        <if>
            <isset property="tlr.merge.file.exists"/>
            <then>
                <mergeSecurityProperties file="${tlr.merge.file}"
                 target="${tcman.alias}.${primary.ablapp.name}.${primary.webapp.name}"/>
            </then>
        </if>

        <!-- Enable the collection of both count-based and time-based metrics (collectMetrics=3). -->
        <local name="openedge.props.file"/>
        <property name="openedge.props.file" value="${catalina.base}${file.separator}conf${file.separator}openedge.properties"/>
        <local name="openedge.props.exists"/>
        <available file="${openedge.props.file}" property="openedge.props.exists"/>
        <if>
            <isset property="openedge.props.exists"/>
            <then>
                <echo message="Forcing collectMetrics=3 in ${openedge.props.file}"/>
                <replaceregexp file="${openedge.props.file}"
                               match="(^\s*collectMetrics\s*=\s*)\d+"
                               replace="\13"
                               byline="true"/>
            </then>
        </if>

        <!-- Override certain ABL Application properties with sane defaults if low system memory is detected. -->
        <!-- Result: Force the use of 2 MSAgents as min/max/initial (w/ 10 Sess/Conn) for the ABL Application. -->
        <if>
            <equals arg1="${has.sufficient.memory}" arg2="false"/>
            <then>
                <echo message="Setting min/max/initial MSAgent to 2 (insufficient system memory: ${system.detected.memory} MB)."/>
                <exec executable="${oeprop.util}" failonerror="false">
                    <arg line="AppServer.SessMgr.${primary.ablapp.name}.maxAgents=2"/>
                </exec>
                <exec executable="${oeprop.util}" failonerror="false">
                    <arg line="AppServer.SessMgr.${primary.ablapp.name}.minAgents=2"/>
                </exec>
                <exec executable="${oeprop.util}" failonerror="false">
                    <arg line="AppServer.SessMgr.${primary.ablapp.name}.numInitialAgents=2"/>
                </exec>
                <exec executable="${oeprop.util}" failonerror="false">
                    <arg line="AppServer.SessMgr.${primary.ablapp.name}.maxConnectionsPerAgent=10"/>
                </exec>
                <exec executable="${oeprop.util}" failonerror="false">
                    <arg line="AppServer.SessMgr.${primary.ablapp.name}.maxABLSessionsPerAgent=10"/>
                </exec>
                <exec executable="${oeprop.util}" failonerror="false">
                    <arg line="AppServer.Agent.${primary.ablapp.name}.numInitialSessions=10"/>
                </exec>
            </then>
        </if>

        <!-- Create a database if schema is available. -->
        <build_db dbPath="${db.path}" dbName="${application.db.name}"/>
    </target>

    <target name="ablapp_export">
        <!-- Called when an ABLApp is being prepared to be exported (from its container). -->
    </target>

    <target name="ablapp_exported">
        <!-- Called when an ABLApp is finished being exported (from its container). -->
    </target>

    <!--
        PASOE tooling currently does not have support for undeploying an ABL application in a single command.
        However, undeploying a web application that is part of the ABLApp will cause these targets to be called
        This is done multiple times as each web application that comprises the ABLApp is undeployed:
    -->

    <target name="ablapp_undeploy">
        <!-- Called when an ABLApp is being prepared to be undeployed (removed from its container). -->
    </target>

    <target name="ablapp_undeployed">
        <!-- Called when an ABLApp is finished being undeployed (removed from its container). -->
    </target>

</project>