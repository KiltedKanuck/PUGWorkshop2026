# PF for running testing tasks
# Supports substitution of tokens
#    - projectDir
#    - buildDir
#    - startupParams (passed in via -PablStartupParams=<val>

${startupParams}

# Setting these here because OEDF does not allow them as properties
-cpinternal UTF-8
-cpstream UTF-8
-cpcoll Basic
-cpcase Basic
-d mdy
-numsep 44
-numdec 46

# Tell ABLUnit which tests should be executed
-param CFG=ablunit.json

# Tell us where to find the ADE (read: adecomm) resources
-baseADE "${dlcHome}/${packageType}"

# Enable memory profiling for a comprehensive report
-profileMemory ${buildDir}/resources/test/mprofiler.config