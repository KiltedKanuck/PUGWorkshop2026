      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="State Setup (Data Load)" enabled="true">
        <stringProp name="TestPlan.comments">PRE-TEST: Loads all 50 US state records into the database for deterministic testing.

PURPOSE: Create baseline test data before main load tests run.

CONFIGURATION:
- Threads: 1 (single thread to ensure sequential creation)
- Loop Count: 50 (one iteration per state from CSV file)
- On Sample Error: Stop Test - CRITICAL! If any state fails to create, the entire test suite halts

DATA SOURCE: us_states.csv containing all 50 US states (abbreviation, full name)

OPERATION: POST only (CREATE) - skips GET, PUT, DELETE

This ensures a known good state for the main load tests. If setup fails, the test cannot proceed reliably.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">50</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Once Only Controller - Load Company Data" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load Company CSV (once)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()

if (props.get(&quot;companyData&quot;) == null) {
    def csvFile = new File(baseDir + &quot;/fictitious_companies.csv&quot;)
    def lines = csvFile.readLines(&quot;UTF-8&quot;)
    def data = lines.drop(1).findAll { it.trim() }.collect { line -&gt;
        // Handle quoted CSV fields
        def cols = []
        def m = (line =~ /&quot;([^&quot;]*)&quot;|([^,]+)/)
        m.each { match -&gt; cols &lt;&lt; (match[1] != null ? match[1] : match[2]) }
        [
            customer_num: cols[0],
            company_name: cols[1],
            franchise:    cols[2],
            medium:       cols[3],
            sector:       cols[4]
        ]
    }
    props.put(&quot;companyData&quot;, data)
    log.info(&quot;Loaded &quot; + data.size() + &quot; companies from fictitious_companies.csv&quot;)
  }

  if (props.get(&quot;stateData&quot;) == null) {
    def statesFile = new File(baseDir + &quot;/us_states.csv&quot;)
    def stateLines = statesFile.readLines(&quot;UTF-8&quot;)
    def stateData = stateLines.drop(1).findAll { it.trim() }.collect { line -&gt;
      def cols = line.split(&quot;,&quot;, 2)
      [state: cols[0], stateName: cols[1]]
    }
    props.put(&quot;stateData&quot;, stateData)
    log.info(&quot;Loaded &quot; + stateData.size() + &quot; states from us_states.csv&quot;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Set state vars from stateData" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def stateData = props.get(&quot;stateData&quot;)
  if (stateData == null || stateData.isEmpty()) {
    throw new IllegalStateException(&quot;stateData not loaded&quot;)
  }
  int idx = (vars.get(&quot;state_setup_idx&quot;) ?: &quot;0&quot;) as int
  def state = stateData[idx % stateData.size()]
  vars.put(&quot;state_state&quot;, state.state)
  vars.put(&quot;state_stateName&quot;, state.stateName)
  vars.put(&quot;state_setup_idx&quot;, String.valueOf(idx + 1))</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223Sampler>
