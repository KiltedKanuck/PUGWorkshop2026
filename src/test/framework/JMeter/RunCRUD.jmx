      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="State Teardown (Data Cleanup)" enabled="true">
        <stringProp name="TestPlan.comments">POST-TEST: Cleans up state records after main load tests complete.

PURPOSE: Verify state records exist and remove them for clean test environment.

CONFIGURATION:
- Threads: 1 (single thread to ensure sequential cleanup)
- Loop Count: 50 (one iteration per state from CSV file)
- On Sample Error: Continue - cleanup attempts should continue even if some records don&apos;t exist

DATA SOURCE: us_states.csv containing all 50 US states (abbreviation, full name)

OPERATIONS:
1. GET (READ) - Check if state record exists
2. DELETE - Remove the state record (only executed if GET succeeds)

This ensures the database is clean after testing, removing the 50 test state records.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">50</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Set teardown state vars from stateData" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def stateData = props.get(&quot;stateData&quot;)
if (stateData == null || stateData.isEmpty()) {
    throw new IllegalStateException(&quot;stateData not loaded&quot;)
}
int idx = (vars.get(&quot;state_teardown_idx&quot;) ?: &quot;0&quot;) as int
def state = stateData[idx % stateData.size()]
vars.put(&quot;state_state&quot;, state.state)
vars.put(&quot;state_stateName&quot;, state.stateName)
vars.put(&quot;state_teardown_idx&quot;, String.valueOf(idx + 1))</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET state (READ)" enabled="true">
          <stringProp name="TestPlan.comments">Checks if state record exists before attempting delete.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/loadsuite/web/api/data/state?state=${state_state}&amp;stateName=${state_stateName}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DELETE state (CLEANUP)" enabled="true">
          <stringProp name="TestPlan.comments">Removes state record. Continues even if record doesn&apos;t exist.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/loadsuite/web/api/data/state?state=${state_state}&amp;stateName=${state_stateName}</stringProp>
          <stringProp name="HTTPSampler.method">DELETE</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
      </hashTree>
