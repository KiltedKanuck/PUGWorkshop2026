{
  "meta": {
    "name": "load-baseline",
    "description": "Baseline load run - steady 200 VUs, 500 total iterations. Use for performance baselines and regression comparisons.",
    "version": 1
  },
  "run": {
    "profile": "load"
  },
  "env": {
    "BASE_URL":                    "http://127.0.0.1:7780",
    "MAX_VUS":                     200,
    "MAX_ITERATIONS":              500,
    "MIN_THINK_TIME":              0.1,
    "MAX_THINK_TIME":              0.4,
    "SEED_RECORD_MAX":             100000,
    "CRUD_WEIGHT":                 0.9,
    "NOOP_WEIGHT":                 0.1,
    "ANOMALY_DISRUPT_WEIGHT":      0.0,
    "ANOMALY_FILES_WEIGHT":        0.0,
    "ANOMALY_LEAK_WEIGHT":         0.0,
    "ANOMALY_SIMULATE_WEIGHT":     0.0
  }
}
