{
  "meta": {
    "name": "smoke",
    "description": "Canonical smoke profile - 1 VU, 1 iteration, no think time. Strictest quality gates: zero failed requests, all checks must pass. Use for pre-commit sanity checks and pipeline health signals.",
    "version": 1
  },
  "run": {
    "profile": "smoke"
  },
  "env": {
    "BASE_URL":                    "http://127.0.0.1:7780",
    "MIN_THINK_TIME":              0,
    "MAX_THINK_TIME":              0,
    "SEED_RECORD_MAX":             100000,
    "CRUD_WEIGHT":                 0.9,
    "NOOP_WEIGHT":                 0.1,
    "ANOMALY_DISRUPT_WEIGHT":      0.0,
    "ANOMALY_FILES_WEIGHT":        0.0,
    "ANOMALY_LEAK_WEIGHT":         0.0,
    "ANOMALY_SIMULATE_WEIGHT":     0.0
  },
  "options": {
    "tags": {
      "suite": "oels",
      "config": "smoke"
    }
  }
}
